# ─────────────────────────────────────────────────────────────────────────────
#  Pulse360 — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=pulse360
POSTGRES_USER=pulse360_user
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_PORT=5432

# Connection string used by the Next.js app at runtime (Prisma / pg).
# For Supabase, use the pooled/session connection string here.
DATABASE_URL=postgresql://pulse360_user:change_me_before_use@localhost:5432/pulse360

# Optional direct database URL used by Prisma CLI migrations and seed tasks.
# For Supabase, use the direct connection string here when reachable.
DIRECT_URL=postgresql://pulse360_user:change_me_before_use@localhost:5432/pulse360

# ── pgAdmin (optional) ────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@pulse360.local
PGADMIN_PASSWORD=change_me_pgadmin
PGADMIN_PORT=5050

# ── App (Next.js) ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# ── AI (optional) ─────────────────────────────────────────────────────────
# Without a key the AI features fall back to stub responses.
OPENAI_API_KEY=

# ── FAQ Assistant / RAG service (server-side only) ────────────────────────
# Base URL of the companion Supabase RAG API (no trailing slash needed).
RAG_API_URL=http://127.0.0.1:8767
# Must equal ADMIN_API_KEY configured on the RAG API. Sent as X-API-Key on
# /collections/* calls only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
RAG_ADMIN_API_KEY=
# Must equal QUERY_API_KEY configured on the RAG API (a different secret from the admin
# key). Sent as X-API-Key on /ask and /search calls only. Server-side only.
RAG_QUERY_API_KEY=
